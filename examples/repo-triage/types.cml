type investigation_mode = QuickScan | DeepDive

type request = {
  task : string;
  suspected_area : string;
  file_hints : string list;
  goals : string list;
  constraints : string list;
  mode : investigation_mode;
}

type normalized_request = {
  task : string;
  suspected_area : string;
  file_hints : string list;
  goals : string list;
  constraints : string list;
  mode_label : string;
  terse_task : string;
}

type search_plan = {
  summary : string;
  file_queries : string list;
  shell_commands : string list;
  checklist : string list;
}

type investigation = {
  overview : string;
  relevant_files : string list;
  findings : string list;
  evidence : string list;
  risks : string list;
  validation_steps : string list;
}

type triage_report = {
  title : string;
  summary : string;
  relevant_files : string list;
  findings : string list;
  root_causes : string list;
  patch_plan : string list;
  validation_steps : string list;
  follow_up_questions : string list;
}
