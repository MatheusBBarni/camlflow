open Types

skill caveman : prompt:string -> string = Skill.bind "caveman"

skill search_planner :
  task:string -> suspected_area:string -> file_hints:string list ->
  goals:string list -> constraints:string list -> mode:string -> search_plan =
  Skill.bind "search-planner"

agent repo_investigator : request:normalized_request -> plan:search_plan -> investigation =
  Agent.define
    ~name:"repo-investigator"
    ~style:"forensic"
    ~system_prompt:"You are a repository triage investigator working inside the target repo. Inspect the repository before answering. Use tools such as read, find, grep, and bash when they help. Prefer concrete file paths, command outputs, and grounded evidence over guesses. Keep the response tightly scoped to the current working directory."

agent triage_reporter :
  request:normalized_request -> plan:search_plan -> investigation:investigation -> triage_report =
  Agent.define
    ~name:"repo-triage-reporter"
    ~style:"practical"
    ~system_prompt:"You turn repository investigation notes into an actionable engineering triage report. Prioritize the most relevant files, evidence, likely root causes, patch steps, and validation steps. Be concrete, concise, and useful to an engineer who wants the next move."

let main (request : request) : triage_report =
  let normalized = Helpers.normalize_request request in
  let caveman_prompt = Helpers.render_caveman_prompt normalized in
  let* terse_task = caveman ~prompt:caveman_prompt in
  let normalized = Helpers.with_terse_task normalized terse_task in
  let* plan =
    search_planner ~task:normalized.task
      ~suspected_area:normalized.suspected_area
      ~file_hints:normalized.file_hints ~goals:normalized.goals
      ~constraints:normalized.constraints ~mode:normalized.mode_label
  in
  let* investigation = repo_investigator ~request:normalized ~plan:plan in
  let* report =
    triage_reporter ~request:normalized ~plan:plan ~investigation:investigation
  in
  report
