open Types

let mode_to_string (mode : investigation_mode) : string =
  match mode with
  | Types.QuickScan -> "quick scan"
  | Types.DeepDive -> "deep dive"

let normalize_request (request : request) : normalized_request =
  {
    task = request.task;
    suspected_area = request.suspected_area;
    file_hints = request.file_hints;
    goals = request.goals;
    constraints = request.constraints;
    mode_label = mode_to_string request.mode;
    terse_task = "";
  }

let with_terse_task (request : normalized_request) (terse_task : string) : normalized_request =
  {
    task = request.task;
    suspected_area = request.suspected_area;
    file_hints = request.file_hints;
    goals = request.goals;
    constraints = request.constraints;
    mode_label = request.mode_label;
    terse_task = terse_task;
  }

let render_caveman_prompt (request : normalized_request) : string =
  "Rewrite this repository triage request in terse caveman style. Preserve repo names, file paths, and command names exactly. Task: "
  ^ request.task ^ ". Suspected area: " ^ request.suspected_area
  ^ ". Investigation mode: " ^ request.mode_label
