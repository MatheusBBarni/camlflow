open Types

let language_to_string (language : language) : string =
  match language with
  | Types.Python -> "Python"
  | Types.TypeScript -> "TypeScript"
  | Types.OCaml -> "OCaml"

let difficulty_to_string (difficulty : difficulty) : string =
  match difficulty with
  | Types.Easy -> "easy"
  | Types.Medium -> "medium"
  | Types.Hard -> "hard"

let focus_to_string (focus : focus) : string =
  match focus with
  | Types.Pattern name -> "pattern: " ^ name
  | Types.DataStructure name -> "data structure: " ^ name
  | Types.Constraint text -> "constraint: " ^ text

let normalize_request (request : request) : normalized_request =
  {
    algorithm_name = request.algorithm_name;
    language = request.preferred_language;
    difficulty = request.target_difficulty;
    language_label = language_to_string request.preferred_language;
    difficulty_label = difficulty_to_string request.target_difficulty;
    focus = request.focus;
    terse_request = "";
  }

let with_terse_request (request : normalized_request) (terse_request : string) : normalized_request =
  {
    algorithm_name = request.algorithm_name;
    language = request.language;
    difficulty = request.difficulty;
    language_label = request.language_label;
    difficulty_label = request.difficulty_label;
    focus = request.focus;
    terse_request = terse_request;
  }

let render_caveman_prompt (request : normalized_request) : string =
  "Rewrite this algorithm request in terse caveman style, but preserve the algorithm name exactly. Language: "
  ^ request.language_label ^ ". Difficulty: " ^ request.difficulty_label
  ^ ". Algorithm: " ^ request.algorithm_name

let hint_for_difficulty (difficulty : difficulty) : string option =
  match difficulty with
  | Types.Easy -> Some "Prefer the simplest correct solution first."
  | Types.Medium -> Some "Explain the tradeoff between brute force and optimized solutions."
  | Types.Hard -> Some "Call out invariants, pruning, and failure modes explicitly."

let planner_difficulty (request : normalized_request) : string =
  difficulty_to_string request.difficulty
