type language = Python | TypeScript | OCaml

type audience = Interview | Study | Implementation

type request = {
  problem_name : string;
  language : language;
  audience : audience;
  must_cover : string list;
}

type normalized_request = {
  problem_name : string;
  language_label : string;
  audience_label : string;
  audience_hint : string;
  must_cover : string list;
  terse_request : string;
}

type draft_solution = {
  core_idea : string;
  explanation : string;
  code : string;
  complexity : string;
}

type solution_pack = {
  title : string;
  answer : string;
  code : string;
  complexity : string;
  edge_cases : string list;
  pitfalls : string list;
  next_steps : string list;
}
