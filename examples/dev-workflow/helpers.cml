open Types

let approval_feedback (approval : approval_state) : string option =
  match approval with
  | ApprovalRejected feedback -> Some feedback
  | ApprovalPending -> None
  | ApprovalGranted -> None

let approval_granted (approval : approval_state) : bool =
  match approval with
  | ApprovalGranted -> true
  | ApprovalPending -> false
  | ApprovalRejected _ -> false

let render_caveman_prompt (planning : planning_result) : string =
  planning.requirements_document.summary ^ "\nApproval summary: "
  ^ planning.approval_summary

let approval_next_step (feedback : string option) : string =
  if is_some feedback then
    "Review the revised requirements document, confirm the feedback is resolved, and rerun with ApprovalGranted."
  else
    "Review the requirements document, approve it, and rerun with ApprovalGranted."

let completion_next_steps (review : review_report) : string list =
  match review.status with
  | ReviewApproved ->
      [
        "Share the requirements, code package, and review report with the team.";
        "Merge or ship the approved change.";
        "Monitor validation signals after rollout.";
      ]
  | ReviewRejected ->
      [
        "Address the reviewer issues.";
        "Refresh the code package after fixes.";
        "Rerun the workflow for another review pass.";
      ]
