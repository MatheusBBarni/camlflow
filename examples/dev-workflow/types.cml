type approval_state =
  | ApprovalPending
  | ApprovalGranted
  | ApprovalRejected of string

type planning_readiness = ReadyForApproval | NeedsUserAnswers

type review_status = ReviewApproved | ReviewRejected

type severity = Low | Medium | High

type workflow_request = {
  description : string;
  prd_text : string option;
  spec_text : string option;
  prior_answers : string list;
  approval : approval_state;
}

type requirements_document = {
  summary : string;
  user_stories : string list;
  acceptance_criteria : string list;
  technical_requirements : string list;
  data_requirements : string list;
  performance_requirements : string list;
  maintainability_requirements : string list;
  test_requirements : string list;
  deployment_requirements : string list;
}

type planning_result = {
  readiness : planning_readiness;
  requirements_document : requirements_document;
  open_questions : string list;
  approval_summary : string;
}

type code_file = {
  path : string;
  change_summary : string;
}

type technical_decision = {
  title : string;
  rationale : string;
}

type dependency = {
  name : string;
  reason : string;
}

type code_package = {
  summary : string;
  implemented_files : code_file list;
  technical_decisions : technical_decision list;
  added_dependencies : dependency list;
}

type review_issue = {
  severity : severity;
  message : string;
  file_hint : string option;
}

type review_report = {
  status : review_status;
  summary : string;
  issues_found : review_issue list;
  suggestions : string list;
}

type clarification_packet = {
  requirements_document : requirements_document;
  open_questions : string list;
  next_step : string;
}

type approval_packet = {
  requirements_document : requirements_document;
  approval_summary : string;
  next_step : string;
}

type completed_report = {
  requirements_document : requirements_document;
  code_package : code_package;
  review_report : review_report;
  next_steps : string list;
}

type workflow_output =
  | Completed of completed_report
  | NeedsClarification of clarification_packet
  | NeedsApproval of approval_packet
