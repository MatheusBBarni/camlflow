{
  "name": "camlflow-vscode",
  "displayName": "CamlFlow",
  "version": "0.1.0",
  "description": "VS Code language support for CamlFlow workflows and camlflow.json",
  "publisher": "camlflow",
  "license": "UNLICENSED",
  "keywords": [
    "camlflow",
    "ocaml",
    "dsl",
    "workflow",
    "vscode"
  ],
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:camlflow"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "scripts": {
    "sync-schema": "node ./scripts/sync-schema.mjs",
    "smoke:highlight": "node ./scripts/smoke-highlight.mjs",
    "test": "npm run smoke:highlight",
    "package": "npm run sync-schema && npx @vscode/vsce package --allow-missing-repository",
    "package:dry-run": "npm run sync-schema && npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "camlflow",
        "aliases": [
          "CamlFlow",
          "camlflow"
        ],
        "extensions": [
          ".cml"
        ],
        "icon": {
          "light": "./icons/camlflow-light.svg",
          "dark": "./icons/camlflow-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "camlflow",
        "scopeName": "source.camlflow",
        "path": "./syntaxes/camlflow.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "camlflow",
        "path": "./snippets/camlflow.code-snippets"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "/camlflow.json",
        "url": "./generated/camlflow.schema.json"
      }
    ],
    "configuration": {
      "title": "CamlFlow",
      "properties": {
        "camlflow.lsp.command": {
          "type": "string",
          "default": "camlflow",
          "description": "Executable used to launch the CamlFlow language server."
        },
        "camlflow.lsp.args": {
          "type": "array",
          "default": [
            "lsp"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the CamlFlow language server executable."
        }
      }
    }
  }
}
