{
  "name": "camlflow-pi-sdk",
  "version": "0.1.0",
  "description": "Programmatic Pi SDK adapter for running CamlFlow workflows through the JSON-RPC bridge",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build:sdk": "tsc -p tsconfig.json",
    "build:examples": "tsc -p examples/tsconfig.json",
    "build": "npm run build:sdk && npm run build:examples",
    "clean": "rm -rf dist examples-dist",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "camlflow",
    "pi",
    "json-rpc",
    "sdk"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "camlflow-ts-json-rpc-sdk": "file:../camlflow-ts-json-rpc-sdk"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.67.6"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.67.6",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
