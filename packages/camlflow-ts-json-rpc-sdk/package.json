{
  "name": "camlflow-ts-json-rpc-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the CamlFlow JSON-RPC stdio bridge",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:sdk": "tsc -p tsconfig.json",
    "build:examples": "tsc -p examples/tsconfig.json",
    "build": "npm run build:sdk && npm run build:examples",
    "clean": "rm -rf dist examples-dist",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "test:pi-mono:launchers": "node --test test/pi-mono-script-launchers.test.js",
    "test:pi-mono": "node --test test/pi-mono-e2e.test.js",
    "doctor:pi-mono": "node test/pi-mono-doctor.js --check-camlflow-build",
    "example:provider-hooks": "npm run build && node examples-dist/provider-hooks.js",
    "example:attach-streams": "npm run build && node examples-dist/attach-streams.js",
    "example:orchestrator-session": "npm run build && node examples-dist/orchestrator-session.js",
    "example:cancellation": "npm run build && node examples-dist/cancellation.js"
  },
  "keywords": [
    "camlflow",
    "json-rpc",
    "sdk",
    "typescript"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}
