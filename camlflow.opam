opam-version: "2.0"
synopsis: "PRD-aligned OCaml scaffold for CamlFlow"
description: "Buildable library, CLI, and test scaffold for the CamlFlow project."
maintainer: ["camlflow contributors"]
authors: ["camlflow contributors"]
license: "MIT"
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.22"}
  "menhir"
  "yojson"
  "alcotest" {with-test}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
